{
  // --- Core Keymap ---
  "outline_panel": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "disable_ai": true,
  "cursor_animation": {
    "enabled": false
  },
  "cursor_blink": true,
  "text_rendering_mode": "platform_default",
  "ui_font_family": "JetBrains Mono",
  "agent_ui_font_family": "JetBrains Mono",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "restore_unsaved_buffers": false
  },
  "default_open_behavior": "new_window",
  "reveal_if_open": true,
  "on_last_window_closed": "quit_app",
  "proxy": "",
  "diff_view_style": "split",
  "base_keymap": "JetBrains",

  // --- Appearance & Theming ---
  "auto_install_extensions": {
    "git-firefly": true,
    "html": true,
    "java": true,
    "jetbrains-themes": true,
    "make": true,
    "material-icon-theme": true,
    "sql": true,
  },
  "auto_update": true,
  "theme": "JetBrains Dark",
  "icon_theme": "Material Icon Theme",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13,

  // --- Editor Layout ---
  "project_panel": {
    "dock": "left",
  },
  "terminal": {
    "dock": "bottom",
    "cursor_shape": "underline",
    "blinking": "on",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
  },

  // --- Editor Behavior ---
  "cli_default_open_behavior": "new_window",
  "autosave": "on_focus_change",
  "format_on_save": "off",
  "soft_wrap": "editor_width",

  // --- AI Agents ---
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "mode": "yolo",
        "model": "gemini-3.7-flash-high"
      },
      "type": "registry"
    },
    "grok-build": {
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },

  // --- Language Servers ---
  "lsp": {
    "jdtls": {
      "settings": {
        "lombok_support": true,
      },
    },
  },
}
