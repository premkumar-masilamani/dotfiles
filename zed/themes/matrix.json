{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Matrix",
  "author": "Premkumar Masilamani",
  "themes": [
    {
      "name": "Matrix",
      "appearance": "dark",
      "style": {
        "background": "#000000ff",
        "editor.background": "#000000ff",
        "editor.foreground": "#00ff41ff",
        "editor.gutter.background": "#000000ff",
        "editor.line_number": "#0a7f2eff",
        "editor.active_line_number": "#00ff41ff",
        "editor.active_line.background": "#04160aff",
        "editor.highlighted_line.background": "#04160aff",
        "text": "#00ff41ff",
        "text.muted": "#0a9e39ff",
        "text.placeholder": "#0a7f2eff",
        "border": "#0a3b1bff",
        "border.variant": "#052712ff",
        "surface.background": "#020a05ff",
        "elevated_surface.background": "#020a05ff",
        "element.background": "#04160aff",
        "element.hover": "#0a3b1bff",
        "element.selected": "#0a3b1bff",
        "ghost_element.hover": "#04160aff",
        "status_bar.background": "#000000ff",
        "title_bar.background": "#000000ff",
        "toolbar.background": "#000000ff",
        "tab_bar.background": "#000000ff",
        "tab.active_background": "#04160aff",
        "tab.inactive_background": "#000000ff",
        "panel.background": "#000000ff",
        "scrollbar.thumb.background": "#0a3b1b80",
        "terminal.background": "#000000ff",
        "terminal.foreground": "#00ff41ff",
        "terminal.bright_foreground": "#4bff70ff",
        "terminal.dim_foreground": "#0a9e39ff",
        "terminal.ansi.black": "#000000ff",
        "terminal.ansi.red": "#008f11ff",
        "terminal.ansi.green": "#00ff41ff",
        "terminal.ansi.yellow": "#00cc33ff",
        "terminal.ansi.blue": "#007a1fff",
        "terminal.ansi.magenta": "#00a329ff",
        "terminal.ansi.cyan": "#00e63cff",
        "terminal.ansi.white": "#70ff8fff",
        "terminal.ansi.bright_black": "#003b00ff",
        "terminal.ansi.bright_red": "#00b317ff",
        "terminal.ansi.bright_green": "#4bff70ff",
        "terminal.ansi.bright_yellow": "#33ff66ff",
        "terminal.ansi.bright_blue": "#00a329ff",
        "terminal.ansi.bright_magenta": "#00cc33ff",
        "terminal.ansi.bright_cyan": "#70ff99ff",
        "terminal.ansi.bright_white": "#c0ffc8ff",
        "syntax": {
          "comment": { "color": "#0a7f2eff" },
          "keyword": { "color": "#4bff70ff" },
          "string": { "color": "#00cc33ff" },
          "function": { "color": "#70ff8fff" },
          "type": { "color": "#33ff66ff" },
          "variable": { "color": "#00ff41ff" },
          "number": { "color": "#00e63cff" },
          "constant": { "color": "#4bff70ff" },
          "punctuation": { "color": "#0a9e39ff" }
        }
      }
    }
  ]
}
